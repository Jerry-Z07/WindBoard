<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WindBoard.CrashReporter</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <UseWindowsForms>true</UseWindowsForms>

    <!--
      高 DPI：经项目文件声明 DPI 感知模式（官方推荐做法），
      ApplicationConfiguration.Initialize() 会据此生成 Application.SetHighDpiMode 调用。
      不要改用 app.manifest：官方明确不建议（与应用配置冲突，且触发编译器警告 WFO0003）。
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!--
      修复：CS0579（程序集特性重复）
      说明：该工程不依赖自动生成的 AssemblyInfo 信息，关闭生成以避免重复导入导致的编译失败。
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!--
      CA1016（用程序集版本标记程序集）：本工程 GenerateAssemblyInfo=false（见上，修复 CS0579
      的既定决策），MSBuild 的 AssemblyVersion 属性在此配置下不会生成特性；若手工维护
      [assembly: AssemblyVersion] 会与 Directory.Build.props 及 release.yml 的版本注入脱节。
      崩溃报告中的版本信息由主进程传入，不依赖本程序集版本特性，故按规则 ID 豁免。
    -->
    <NoWarn>$(NoWarn);CA1016</NoWarn>
  </PropertyGroup>
</Project>

