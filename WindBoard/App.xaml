<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WindBoard.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindBoard">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!-- 画布背景色：供页面缩略图等 XAML 元素复用（运行时会同步为当前设置值）。 -->
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#2E2F33" />

            <!-- Dock：通用按钮样式（全局资源，供主 Dock 与选中项 Dock 复用） -->
            <Style
                x:Key="DockButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="DockToggleButtonStyle"
                TargetType="ToggleButton"
                BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--
              图标字体：
              - Win11（Build >= 22000）系统自带 Segoe Fluent Icons；
              - Win10 安装版由安装器安装字体；便携版在启动时私有加载内置 ttf；
              - 若最终不可用，会在启动时降级为 Segoe MDL2 Assets，避免图标变成方块。
            -->
            <FontFamily x:Key="SymbolThemeFontFamily">Segoe Fluent Icons</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
