<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindBoard.Settings.Pages.DockSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindBoard.Settings.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="DockPreviewListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="DockPreviewItemBorderStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24">
                <TextBlock Text="Dock 设置" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="长按并拖动下方按钮，可调整它们在 Dock 中的显示顺序（支持触摸拖动）。"
                    Opacity="0.75"
                    TextWrapping="WrapWholeWords" />

                <StackPanel Spacing="10">
                    <TextBlock Text="预览" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <!-- Dock 预览固定为浅色主题，保持与主界面 Dock 视觉一致 -->
                    <Grid RequestedTheme="Light">
                        <!--
                            说明：设置页内容区域会受到左侧导航栏占用宽度的影响，
                            如果把左/中/右三段 Dock 强行放在同一行，窗口稍窄就会互相挤压甚至重叠。
                            这里改为“分三行预览”，既能保持左右/中部的相对定位，又能避免 UI 挤压。
                        -->
                        <Grid x:Name="DockPreviewLayoutGrid" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

                            <!-- 左侧 Dock -->
                            <Grid
                                x:Name="LeftDockPreviewContainer"
                                Grid.Row="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom">
                                <Border
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="14"
                                    Opacity="0.85" />
                                <ListView
                                    x:Name="LeftDockListView"
                                    ItemsSource="{x:Bind LeftDockItems, Mode=OneWay}"
                                    SelectionMode="None"
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    CanReorderItems="True"
                                    DragItemsCompleted="OnDockItemsDragCompleted"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ItemContainerStyle="{StaticResource DockPreviewListViewItemStyle}"
                                    Margin="5">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:DockItemViewModel">
                                            <Border Style="{StaticResource DockPreviewItemBorderStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <IconSourceElement IconSource="{x:Bind IconSource}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Margin="0,3,0,0"
                                                        HorizontalAlignment="Center"
                                                        Text="{x:Bind Title}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- 中部 Dock -->
                            <Grid
                                x:Name="CenterDockPreviewContainer"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom">
                                <Border
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="14"
                                    Opacity="0.85" />

                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="5">
                                    <ListView
                                        x:Name="ToolsDockListView"
                                        ItemsSource="{x:Bind ToolsDockItems, Mode=OneWay}"
                                        SelectionMode="None"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        DragItemsCompleted="OnDockItemsDragCompleted"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ItemContainerStyle="{StaticResource DockPreviewListViewItemStyle}">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>

                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:DockItemViewModel">
                                                <Border Style="{StaticResource DockPreviewItemBorderStyle}">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <IconSourceElement IconSource="{x:Bind IconSource}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Margin="0,3,0,0"
                                                            HorizontalAlignment="Center"
                                                            Text="{x:Bind Title}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <Rectangle
                                        x:Name="UndoRedoSeparator"
                                        Width="1"
                                        Height="30"
                                        Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                        VerticalAlignment="Center" />

                                    <ListView
                                        x:Name="UndoRedoDockListView"
                                        ItemsSource="{x:Bind UndoRedoDockItems, Mode=OneWay}"
                                        SelectionMode="None"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        DragItemsCompleted="OnDockItemsDragCompleted"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ItemContainerStyle="{StaticResource DockPreviewListViewItemStyle}">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>

                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:DockItemViewModel">
                                                <Border Style="{StaticResource DockPreviewItemBorderStyle}">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <IconSourceElement IconSource="{x:Bind IconSource}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Margin="0,3,0,0"
                                                            HorizontalAlignment="Center"
                                                            Text="{x:Bind Title}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Grid>

                            <!-- 右侧 Dock -->
                            <Grid
                                x:Name="RightDockPreviewContainer"
                                Grid.Row="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                                <Border
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="14"
                                    Opacity="0.85" />
                                <ListView
                                    x:Name="PagesDockListView"
                                    ItemsSource="{x:Bind PagesDockItems, Mode=OneWay}"
                                    SelectionMode="None"
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    CanReorderItems="True"
                                    DragItemsCompleted="OnDockItemsDragCompleted"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ItemContainerStyle="{StaticResource DockPreviewListViewItemStyle}"
                                    Margin="5">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:DockItemViewModel">
                                            <Border Style="{StaticResource DockPreviewItemBorderStyle}">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <IconSourceElement IconSource="{x:Bind IconSource}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Margin="0,3,0,0"
                                                        HorizontalAlignment="Center"
                                                        Text="{x:Bind Title}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="选项" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <ToggleSwitch
                        x:Name="UndoRedoVisibleToggleSwitch"
                        Header="显示撤销/重做区域"
                        OffContent="隐藏"
                        OnContent="显示"
                        Toggled="OnUndoRedoVisibleToggled" />

                    <Button
                        Content="恢复 Dock 默认布局"
                        HorizontalAlignment="Left"
                        Click="OnResetToDefaultClicked" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
