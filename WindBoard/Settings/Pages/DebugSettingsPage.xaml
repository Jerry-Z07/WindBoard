<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindBoard.Settings.Pages.DebugSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24">
                <TextBlock Text="{l10n:Loc Key=Settings_Debug_Title}" Style="{ThemeResource TitleTextBlockStyle}" />

                <InfoBar
                    x:Name="ActionFeedbackBar"
                    IsOpen="False"
                    IsClosable="True"
                    IsIconVisible="True"
                    Severity="Informational" />

                <StackPanel Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Debug_Logs_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Button Style="{StaticResource SettingsCardButtonStyle}" Click="OnOpenLogDirectoryClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 日志目录 -->
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE8B7;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_OpenLogDir_Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_OpenLogDir_Description}" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SettingsCardButtonStyle}" Click="OnOpenCurrentLogFileClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 当前日志文件 -->
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE8A5;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_OpenCurrentLogFile_Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_OpenCurrentLogFile_Description}" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SettingsCardButtonStyle}" Click="OnCopyLogDirectoryClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 复制 -->
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE8C8;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_CopyLogDir_Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_CopyLogDir_Description}" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Debug_SettingsFile_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Button Style="{StaticResource SettingsCardButtonStyle}" Click="OnOpenSettingsDirectoryClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE8B7;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_OpenSettingsDir_Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_OpenSettingsDir_Description}" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SettingsCardButtonStyle}" Click="OnOpenSettingsFileClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE8A5;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_OpenSettingsFile_Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_OpenSettingsFile_Description}" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SettingsCardButtonStyle}" Click="OnCopySettingsFilePathClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE8C8;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_CopySettingsPath_Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_CopySettingsPath_Description}" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Debug_Tests_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Button Style="{StaticResource SettingsCardButtonStyle}" Click="OnSendTestToastClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 消息推送/通知测试 -->
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE7ED;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_SendTestToast_Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_SendTestToast_Description}" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="SessionSection" Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Debug_Session_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Button Style="{StaticResource SettingsCardButtonStyle}" Click="OnHideDebugEntryThisSessionClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 隐藏入口 -->
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE7EE;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_HideEntry_Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{l10n:Loc Key=Settings_Debug_HideEntry_Description}" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

