<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindBoard.Settings.Pages.DebugSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24">
                <TextBlock Text="{l10n:Loc Key=Settings_Debug_Title}" Style="{ThemeResource TitleTextBlockStyle}" />

                <InfoBar
                    x:Name="ActionFeedbackBar"
                    IsOpen="False"
                    IsClosable="True"
                    IsIconVisible="True"
                    Severity="Informational" />

                <StackPanel Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Debug_Logs_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnOpenLogDirectoryClicked"
                        Header="{l10n:Loc Key=Settings_Debug_OpenLogDir_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_OpenLogDir_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- 日志目录 -->
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE8B7;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnOpenCurrentLogFileClicked"
                        Header="{l10n:Loc Key=Settings_Debug_OpenCurrentLogFile_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_OpenCurrentLogFile_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- 当前日志文件 -->
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE8A5;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnCopyLogDirectoryClicked"
                        Header="{l10n:Loc Key=Settings_Debug_CopyLogDir_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_CopyLogDir_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- 复制 -->
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE8C8;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Debug_SettingsFile_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnOpenSettingsDirectoryClicked"
                        Header="{l10n:Loc Key=Settings_Debug_OpenSettingsDir_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_OpenSettingsDir_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE8B7;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnOpenSettingsFileClicked"
                        Header="{l10n:Loc Key=Settings_Debug_OpenSettingsFile_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_OpenSettingsFile_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE8A5;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnCopySettingsFilePathClicked"
                        Header="{l10n:Loc Key=Settings_Debug_CopySettingsPath_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_CopySettingsPath_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE8C8;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Debug_Tests_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnSendTestToastClicked"
                        Header="{l10n:Loc Key=Settings_Debug_SendTestToast_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_SendTestToast_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- 消息推送/通知测试 -->
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE7ED;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnShowTestInAppBannerClicked"
                        Header="{l10n:Loc Key=Settings_Debug_ShowTestBanner_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_ShowTestBanner_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- 应用内右上角弹条测试 -->
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE7F4;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnCrashWinUiClicked"
                        Header="{l10n:Loc Key=Settings_Debug_CrashWinUi_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_CrashWinUi_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- 崩溃测试：WinUI UI 线程未处理异常 -->
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xEA39;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnCrashAppDomainClicked"
                        Header="{l10n:Loc Key=Settings_Debug_CrashAppDomain_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_CrashAppDomain_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- 崩溃测试：AppDomain 后台线程未处理异常 -->
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xEA39;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="SessionSection" Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Debug_Session_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnHideDebugEntryThisSessionClicked"
                        Header="{l10n:Loc Key=Settings_Debug_HideEntry_Title}"
                        Description="{l10n:Loc Key=Settings_Debug_HideEntry_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- 隐藏入口 -->
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE7EE;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
