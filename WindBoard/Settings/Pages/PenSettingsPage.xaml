<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindBoard.Settings.Pages.PenSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 颜色：圆形色块（背景始终透明，选中态用描边提示） -->
        <Style x:Key="PenColorSwatchToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource SharedPenColorSwatchToggleButtonStyle}" />

        <!-- 粗细：仅用于“预览”，不响应交互 -->
        <Style x:Key="PenThicknessPreviewToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource SharedPenThicknessToggleButtonStyle}">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Page.Resources>

        <Grid>
        <ScrollViewer>
            <StackPanel Spacing="4" Padding="24">
                <StackPanel Spacing="4">
                    <TextBlock Text="{l10n:Loc Key=Common_Preview}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <!-- 预览区域固定为浅色主题，保持与主界面“画笔设置 Flyout”一致 -->
                    <Border
                        CornerRadius="14"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        RequestedTheme="Light">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Text="{l10n:Loc Key=Settings_Pen_Title}"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Opacity="0.85"
                                Margin="16,12,16,10" />

                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource SharedPenFlyoutDividerBrush}" />

                            <StackPanel Grid.Row="2" Spacing="12" Padding="14">
                                <!-- 颜色预览（可点击选择要编辑的色块） -->
                                <Grid
                                    x:Name="PalettePreviewGrid"
                                    RowSpacing="14"
                                    ColumnSpacing="14"
                                    HorizontalAlignment="Left">
                                    <Grid.Resources>
                                        <SolidColorBrush x:Key="ToggleButtonBackground" Color="#00000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#00000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#00000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#00000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#00000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#00000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#00000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#00000000" />

                                        <!-- 未选中态边框更轻一些；选中态仍用高亮描边提示 -->
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#1F000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#33000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#33000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#14000000" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#FF1976D2" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#FF1976D2" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#FF1976D2" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="#551976D2" />
                                    </Grid.Resources>
                                </Grid>

                                <!-- 粗细预览：三档 -->
                                <StackPanel x:Name="ThicknessPresetsPreviewPanel" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                                    <ToggleButton Style="{StaticResource PenThicknessPreviewToggleButtonStyle}">
                                        <Line
                                            x:Name="ThicknessPresetPreviewLine1"
                                            X1="12"
                                            Y1="22"
                                            X2="32"
                                            Y2="22"
                                            Stroke="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                            StrokeThickness="2"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round" />
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource PenThicknessPreviewToggleButtonStyle}">
                                        <Line
                                            x:Name="ThicknessPresetPreviewLine2"
                                            X1="12"
                                            Y1="22"
                                            X2="32"
                                            Y2="22"
                                            Stroke="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                            StrokeThickness="3"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round" />
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource PenThicknessPreviewToggleButtonStyle}">
                                        <Line
                                            x:Name="ThicknessPresetPreviewLine3"
                                            X1="12"
                                            Y1="22"
                                            X2="32"
                                            Y2="22"
                                            Stroke="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                            StrokeThickness="5"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round" />
                                    </ToggleButton>
                                </StackPanel>

                                <!-- 粗细预览：滑条 -->
                                <StackPanel x:Name="ThicknessSliderPreviewPanel" Spacing="6" Visibility="Collapsed">
                                    <TextBlock Text="{l10n:Loc Key=Common_Thickness}" Opacity="0.75" />
                                    <Slider
                                        x:Name="ThicknessPreviewSlider"
                                        Minimum="0.5"
                                        Maximum="64"
                                        Value="3"
                                        SmallChange="0.5"
                                        StepFrequency="0.5"
                                        IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{l10n:Loc Key=Common_Color}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <controls:SettingsCard
                        Header="{l10n:Loc Key=Settings_Pen_PaletteCount_Header}"
                        Description="{l10n:Loc Key=Settings_Pen_PaletteHint}">
                        <controls:SettingsCard.Content>
                            <NumberBox
                                x:Name="PaletteCountNumberBox"
                                Header="{x:Null}"
                                Minimum="3"
                                Maximum="24"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnPaletteCountValueChanged" />
                        </controls:SettingsCard.Content>
                    </controls:SettingsCard>

                    <StackPanel x:Name="SelectColorHintPanel" Spacing="6">
                        <TextBlock
                            Text="{l10n:Loc Key=Settings_Pen_DefaultColorEdit_Title}"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="{l10n:Loc Key=Settings_Pen_SelectColorHint}"
                            Opacity="0.75"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel x:Name="ColorEditorPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="SelectedColorTitleTextBlock" Text="{l10n:Loc Key=Settings_Pen_DefaultColorEdit_Title}" FontWeight="SemiBold" />

                        <ColorPicker
                            x:Name="SelectedColorPicker"
                            IsAlphaEnabled="False"
                            IsColorChannelTextInputVisible="False"
                            IsMoreButtonVisible="False"
                            ColorSpectrumShape="Box"
                            ColorChanged="OnSelectedColorChanged" />

                        <Button
                            Content="{l10n:Loc Key=Settings_Pen_ClearSwatch_Button}"
                            HorizontalAlignment="Left"
                            Click="OnClearSelectedColorClicked" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{l10n:Loc Key=Common_Thickness}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <controls:SettingsCard Header="{l10n:Loc Key=Settings_Pen_UseThicknessSlider_Header}">
                        <controls:SettingsCard.Content>
                            <ToggleSwitch
                                x:Name="UseThicknessSliderToggleSwitch"
                                Header="{x:Null}"
                                OffContent="{l10n:Loc Key=Settings_Pen_ThicknessMode_Presets}"
                                OnContent="{l10n:Loc Key=Settings_Pen_ThicknessMode_Slider}"
                                Toggled="OnUseThicknessSliderToggled" />
                        </controls:SettingsCard.Content>
                    </controls:SettingsCard>

                    <StackPanel x:Name="ThicknessPresetsEditorPanel" Spacing="4">
                        <TextBlock Text="{l10n:Loc Key=Settings_Pen_ThicknessPresets_Hint}" Opacity="0.75" TextWrapping="WrapWholeWords" />

                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:SettingsCard
                                Header="{l10n:Loc Key=Settings_Pen_ThicknessPreset1_Header}">
                                <controls:SettingsCard.Content>
                                    <NumberBox
                                        x:Name="ThicknessPreset1NumberBox"
                                        Header="{x:Null}"
                                        Minimum="0.5"
                                        Maximum="64"
                                        SmallChange="0.5"
                                        SpinButtonPlacementMode="Inline"
                                        Tag="0"
                                        ValueChanged="OnThicknessPresetValueChanged" />
                                </controls:SettingsCard.Content>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                Grid.Column="1"
                                Header="{l10n:Loc Key=Settings_Pen_ThicknessPreset2_Header}">
                                <controls:SettingsCard.Content>
                                    <NumberBox
                                        x:Name="ThicknessPreset2NumberBox"
                                        Header="{x:Null}"
                                        Minimum="0.5"
                                        Maximum="64"
                                        SmallChange="0.5"
                                        SpinButtonPlacementMode="Inline"
                                        Tag="1"
                                        ValueChanged="OnThicknessPresetValueChanged" />
                                </controls:SettingsCard.Content>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                Grid.Column="2"
                                Header="{l10n:Loc Key=Settings_Pen_ThicknessPreset3_Header}">
                                <controls:SettingsCard.Content>
                                    <NumberBox
                                        x:Name="ThicknessPreset3NumberBox"
                                        Header="{x:Null}"
                                        Minimum="0.5"
                                        Maximum="64"
                                        SmallChange="0.5"
                                        SpinButtonPlacementMode="Inline"
                                        Tag="2"
                                        ValueChanged="OnThicknessPresetValueChanged" />
                                </controls:SettingsCard.Content>
                            </controls:SettingsCard>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
