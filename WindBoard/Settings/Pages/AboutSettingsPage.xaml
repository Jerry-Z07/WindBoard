<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindBoard.Settings.Pages.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24">
                <TextBlock Text="{l10n:Loc Key=Settings_About_Title}" Style="{ThemeResource TitleTextBlockStyle}" />

                <InfoBar
                    x:Name="DebugUnlockInfoBar"
                    IsOpen="False"
                    IsClosable="True"
                    IsIconVisible="True"
                    Severity="Informational"
                    Message="{l10n:Loc Key=Settings_About_DebugUnlocked_Message}" />

                <Border
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Image
                            x:Name="AppIconImage"
                            Width="56"
                            Height="56"
                            Stretch="Uniform"
                            Source="ms-appx:///Assets/icon.png"
                            Tapped="OnAppIconTapped" />

                        <TextBlock
                            x:Name="AppNameTextBlock"
                            Grid.Column="1"
                            FontSize="26"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock
                            Text="{l10n:Loc Key=Settings_About_Version}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="VersionTextBlock"
                            Grid.Column="1"
                            Opacity="0.75"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock
                            Text="{l10n:Loc Key=Settings_About_AutoCheckUpdates}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="AutoCheckUpdatesComboBox"
                            Grid.Column="1"
                            MinWidth="160"
                            SelectedValuePath="Tag"
                            SelectionChanged="OnAutoCheckUpdatesSelectionChanged">
                            <ComboBoxItem Content="{l10n:Loc Key=Settings_About_Interval_Weekly}" Tag="weekly" />
                            <ComboBoxItem Content="{l10n:Loc Key=Settings_About_Interval_Biweekly}" Tag="biweekly" />
                            <ComboBoxItem Content="{l10n:Loc Key=Settings_About_Interval_Monthly}" Tag="monthly" />
                            <ComboBoxItem Content="{l10n:Loc Key=Settings_About_Interval_Never}" Tag="never" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="{l10n:Loc Key=Updates_DownloadSource_Title}"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DownloadSourceStatusTextBlock"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <ComboBox
                            x:Name="DownloadSourceComboBox"
                            Grid.Column="1"
                            MinWidth="160"
                            SelectedValuePath="Tag"
                            SelectionChanged="OnDownloadSourceSelectionChanged">
                            <ComboBoxItem Content="{l10n:Loc Key=Updates_DownloadSource_Auto}" Tag="auto" />
                            <ComboBoxItem Content="{l10n:Loc Key=Updates_DownloadSource_Github}" Tag="github" />
                            <ComboBoxItem Content="{l10n:Loc Key=Updates_DownloadSource_GhProxy}" Tag="gh-proxy" />
                            <ComboBoxItem Content="{l10n:Loc Key=Updates_DownloadSource_Felicity}" Tag="felicity" />
                            <ComboBoxItem Content="{l10n:Loc Key=Updates_DownloadSource_07}" Tag="07" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Button
                    x:Name="CheckUpdatesButton"
                    Style="{StaticResource SettingsCardButtonStyle}"
                    Click="OnCheckUpdatesClicked">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Glyph="&#xE895;"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            Text="{l10n:Loc Key=Settings_About_CheckUpdates}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                        <FontIcon
                            x:Name="CheckUpdatesChevronIcon"
                            Grid.Column="2"
                            Glyph="&#xE76C;"
                            FontFamily="Segoe MDL2 Assets"
                            Opacity="0.65"
                            VerticalAlignment="Center" />

                        <ProgressRing
                            x:Name="CheckUpdatesProgressRing"
                            Grid.Column="2"
                            Width="18"
                            Height="18"
                            IsActive="False"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
