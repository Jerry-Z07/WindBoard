<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindBoard.Settings.Pages.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

        <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24">
                <InfoBar
                    x:Name="LanguageRestartInfoBar"
                    IsOpen="False"
                    IsClosable="True"
                    IsIconVisible="True"
                    Severity="Informational"
                    Message="{l10n:Loc Key=Settings_General_Language_RestartTip}" />

                <controls:SettingsCard
                    Header="{l10n:Loc Key=Settings_General_Language_Title}"
                    Description="{l10n:Loc Key=Settings_General_Language_Description}">
                    <controls:SettingsCard.HeaderIcon>
                        <!-- 语言：使用“地球/世界”语义图标 -->
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE909;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Content>
                        <ComboBox
                            x:Name="LanguageComboBox"
                            MinWidth="160"
                            SelectedValuePath="Tag"
                            SelectionChanged="OnLanguageSelectionChanged" />
                    </controls:SettingsCard.Content>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{l10n:Loc Key=Settings_General_StartupWindowMode_Title}"
                    Description="{l10n:Loc Key=Settings_General_StartupWindowMode_Description}">
                    <controls:SettingsCard.HeaderIcon>
                        <!-- 启动时窗口形态：使用“全屏”语义图标 -->
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE740;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Content>
                        <ComboBox
                            x:Name="StartupWindowModeComboBox"
                            MinWidth="160"
                            SelectedValuePath="Tag"
                            SelectionChanged="OnStartupWindowModeSelectionChanged" />
                    </controls:SettingsCard.Content>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{l10n:Loc Key=Settings_General_EnterScreenAnnotationWhenMinimized_Title}"
                    Description="{l10n:Loc Key=Settings_General_EnterScreenAnnotationWhenMinimized_Description}">
                    <controls:SettingsCard.HeaderIcon>
                        <!-- 最小化进入屏幕批注：使用“批注/便签”语义图标 -->
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE70B;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Content>
                        <ToggleSwitch
                            x:Name="EnterScreenAnnotationWhenMinimizedToggleSwitch"
                            Toggled="OnEnterScreenAnnotationWhenMinimizedToggled" />
                    </controls:SettingsCard.Content>
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Name="CamouflageSettingsCard"
                    IsClickEnabled="True"
                    Click="OnCamouflageSettingsClicked"
                    Header="{l10n:Loc Key=Settings_Camouflage_Title}"
                    Description="{l10n:Loc Key=Settings_Camouflage_Description}">
                    <controls:SettingsCard.HeaderIcon>
                        <!-- 伪装：使用“眼镜/隐身”语义图标 -->
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE7EE;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

