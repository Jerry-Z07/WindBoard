<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindBoard.Settings.Pages.AppearanceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Name="CanvasBackgroundPreviewBrush" Color="#2E2F33" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24">
                <TextBlock Text="{l10n:Loc Key=Settings_Appearance_Title}" Style="{ThemeResource TitleTextBlockStyle}" />

                <!--
                    顶层入口建议以“卡片网格”呈现：窗口较宽时左右两列，较窄时自动变为单列，避免右侧留白。
                -->
                <Grid x:Name="CardsGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SecondColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CardsLayoutStates">
                            <VisualState x:Name="Narrow">
                                <VisualState.Setters>
                                    <Setter Target="SecondColumn.Width" Value="0" />
                                    <Setter Target="DockSettingsCard.(Grid.Row)" Value="1" />
                                    <Setter Target="DockSettingsCard.(Grid.Column)" Value="0" />
                                    <Setter Target="ElementCardThemeCard.(Grid.Row)" Value="2" />
                                    <Setter Target="ElementCardThemeCard.(Grid.Column)" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Wide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="720" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="SecondColumn.Width" Value="*" />
                                    <Setter Target="DockSettingsCard.(Grid.Row)" Value="0" />
                                    <Setter Target="DockSettingsCard.(Grid.Column)" Value="1" />
                                    <Setter Target="ElementCardThemeCard.(Grid.Row)" Value="1" />
                                    <Setter Target="ElementCardThemeCard.(Grid.Column)" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <!-- 入口卡片：点击打开二级弹窗（颜色选择器 + HEX 输入） -->
                    <controls:SettingsCard
                        x:Name="CanvasBackgroundCard"
                        IsClickEnabled="True"
                        Click="OnCanvasBackgroundClicked"
                        Header="{l10n:Loc Key=Settings_Background_CanvasBackgroundColor_Title}"
                        Description="{l10n:Loc Key=Settings_Background_CanvasBackgroundColor_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- Segoe MDL2 Assets：Color（更贴合“画布背景颜色”语义） -->
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE790;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border
                                    Width="20"
                                    Height="20"
                                    CornerRadius="4"
                                    Background="{x:Bind CanvasBackgroundPreviewBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                <TextBlock x:Name="CurrentHexTextBlock" Text="{l10n:Loc Key=Settings_Background_HexPlaceholder}" Opacity="0.75" />
                            </StackPanel>
                        </controls:SettingsCard.Content>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        x:Name="DockSettingsCard"
                        Grid.Row="1"
                        IsClickEnabled="True"
                        Click="OnDockSettingsClicked"
                        Header="{l10n:Loc Key=Settings_Dock_Title}"
                        Description="{l10n:Loc Key=Settings_Dock_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE8A5;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        x:Name="ElementCardThemeCard"
                        Grid.Row="2"
                        IsClickEnabled="True"
                        Click="OnElementCardThemeClicked"
                        Header="{l10n:Loc Key=Settings_Appearance_ElementCardTheme_Title}"
                        Description="{l10n:Loc Key=Settings_Appearance_ElementCardTheme_Description}">
                        <controls:SettingsCard.HeaderIcon>
                            <!-- Segoe MDL2 Assets：Color -->
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE790;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Content>
                            <TextBlock
                                x:Name="CurrentElementCardThemeTextBlock"
                                Opacity="0.75"
                                VerticalAlignment="Center"
                                Text="{l10n:Loc Key=Settings_Appearance_ElementCardTheme_Dark}" />
                        </controls:SettingsCard.Content>
                    </controls:SettingsCard>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="CanvasBackgroundDialog"
            Title="{l10n:Loc Key=Settings_Background_CanvasBackgroundColor_Title}"
            PrimaryButtonText="{l10n:Loc Key=Common_OK}"
            CloseButtonText="{l10n:Loc Key=Common_Cancel}">
            <StackPanel Spacing="12">
                <ColorPicker
                    x:Name="DialogColorPicker"
                    IsAlphaEnabled="False"
                    IsColorChannelTextInputVisible="False"
                    IsMoreButtonVisible="False"
                    ColorSpectrumShape="Box"
                    ColorChanged="OnDialogColorChanged" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="DialogHexTextBox"
                        Header="{l10n:Loc Key=Settings_Background_HexHeader}"
                        PlaceholderText="{l10n:Loc Key=Settings_Background_HexPlaceholder}"
                        TextChanged="OnDialogHexTextChanged" />

                    <Button
                        Grid.Column="1"
                        Content="{l10n:Loc Key=Common_ResetToDefault}"
                        VerticalAlignment="Bottom"
                        Click="OnDialogResetToDefaultClicked" />
                </Grid>

                <InfoBar
                    x:Name="DialogHexErrorBar"
                    IsOpen="False"
                    Severity="Error"
                    Message="{l10n:Loc Key=Settings_Background_HexError}"
                    IsIconVisible="True" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="ElementCardThemeDialog"
            Title="{l10n:Loc Key=Settings_Appearance_ElementCardTheme_DialogTitle}"
            PrimaryButtonText="{l10n:Loc Key=Common_OK}"
            CloseButtonText="{l10n:Loc Key=Common_Cancel}">
            <StackPanel Spacing="12">
                <RadioButton
                    x:Name="ElementCardThemeDarkRadioButton"
                    Content="{l10n:Loc Key=Settings_Appearance_ElementCardTheme_Dark}"
                    IsChecked="True" />
                <RadioButton
                    x:Name="ElementCardThemeLightRadioButton"
                    Content="{l10n:Loc Key=Settings_Appearance_ElementCardTheme_Light}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
