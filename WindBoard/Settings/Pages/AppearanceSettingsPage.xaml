<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindBoard.Settings.Pages.AppearanceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Name="CanvasBackgroundPreviewBrush" Color="#2E2F33" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24">
                <TextBlock Text="外观" Style="{ThemeResource TitleTextBlockStyle}" />

                <!--
                    顶层入口建议以“卡片网格”呈现：窗口较宽时左右两列，较窄时自动变为单列，避免右侧留白。
                -->
                <Grid x:Name="CardsGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SecondColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CardsLayoutStates">
                            <VisualState x:Name="Narrow">
                                <VisualState.Setters>
                                    <Setter Target="SecondColumn.Width" Value="0" />
                                    <Setter Target="DockSettingsCard.(Grid.Row)" Value="1" />
                                    <Setter Target="DockSettingsCard.(Grid.Column)" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Wide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="720" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="SecondColumn.Width" Value="*" />
                                    <Setter Target="DockSettingsCard.(Grid.Row)" Value="0" />
                                    <Setter Target="DockSettingsCard.(Grid.Column)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <!-- 入口卡片：点击打开二级弹窗（颜色选择器 + HEX 输入） -->
                    <Button x:Name="CanvasBackgroundCard" Style="{StaticResource SettingsCardButtonStyle}" Click="OnCanvasBackgroundClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Segoe MDL2 Assets：Color（更贴合“画布背景颜色”语义） -->
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE790;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="画布背景颜色" FontWeight="SemiBold" />
                                <TextBlock Text="设置画布的背景颜色" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border
                                    Width="20"
                                    Height="20"
                                    CornerRadius="4"
                                    Background="{x:Bind CanvasBackgroundPreviewBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                <TextBlock x:Name="CurrentHexTextBlock" Text="#2E2F33" Opacity="0.75" />
                            </StackPanel>

                            <!-- 右侧箭头（Segoe MDL2 Assets：ChevronRight） -->
                            <FontIcon
                                Grid.Column="3"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="DockSettingsCard"
                        Grid.Row="1"
                        Style="{StaticResource SettingsCardButtonStyle}"
                        Click="OnDockSettingsClicked">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE8A5;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Dock 设置" FontWeight="SemiBold" />
                                <TextBlock Text="调整 Dock 内组件的位置与显隐" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Opacity="0.65"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="CanvasBackgroundDialog"
            Title="画布背景颜色"
            PrimaryButtonText="确定"
            CloseButtonText="取消">
            <StackPanel Spacing="12">
                <ColorPicker
                    x:Name="DialogColorPicker"
                    IsAlphaEnabled="False"
                    IsColorChannelTextInputVisible="False"
                    IsMoreButtonVisible="False"
                    ColorSpectrumShape="Box"
                    ColorChanged="OnDialogColorChanged" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="DialogHexTextBox"
                        Header="HEX"
                        PlaceholderText="#2E2F33"
                        TextChanged="OnDialogHexTextChanged" />

                    <Button
                        Grid.Column="1"
                        Content="恢复默认"
                        VerticalAlignment="Bottom"
                        Click="OnDialogResetToDefaultClicked" />
                </Grid>

                <InfoBar
                    x:Name="DialogHexErrorBar"
                    IsOpen="False"
                    Severity="Error"
                    Message="HEX 颜色格式无效，请使用 #RRGGBB（例如 #2E2F33）"
                    IsIconVisible="True" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
