<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>WindBoard</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!--
      仅在 VS/显式平台发布时选择对应 pubxml，避免命令行 dotnet publish 默认 Platform=AnyCPU 时
      误去加载不存在的 win-AnyCPU.pubxml，从而触发 NETSDK1198。
    -->
    <PublishProfile Condition="'$(Platform)' == 'x86' or '$(Platform)' == 'x64' or '$(Platform)' == 'ARM64'">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- 伪装功能需要生成/处理 .ico：使用 System.Drawing（Windows-only）。 -->
    <UseSystemDrawing>true</UseSystemDrawing>
    <WindBoardGeneratedLocalizationDir>$(MSBuildProjectDirectory)\obj\Generated\Localization\</WindBoardGeneratedLocalizationDir>
    <WindBoardLocalizationMetadataFile>$(WindBoardGeneratedLocalizationDir)L10nResourceMetadata.g.cs</WindBoardLocalizationMetadataFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated\**\*.cs" />
    <None Remove="Strings\**\*.resw" />
    <PRIResource Remove="Strings\**\*.resw" />
    <PRIResource Include="Strings\**\*.resw" />
    <Compile Include="$(WindBoardLocalizationMetadataFile)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Eraser.svg" />
    <Content Include="Assets\icon.ico" />
    <Content Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      dotnet publish 默认不会把这些静态资源复制到发布目录，导致便携版/安装包缺少 Assets 后，
      WinUI 在加载 XAML（例如 SvgImageSource / 图标资源）时会触发 XamlParseException（启动即崩溃）。
    -->
    <Content Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Helpers" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="DevWinUI.Controls" Version="9.9.4" />
    <PackageReference Include="Markdig" Version="1.1.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.2" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug' and '$(SelfContained)' == 'true'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug' and '$(SelfContained)' != 'true'">True</PublishReadyToRun>
    <!--
      重要：WinUI 3（Windows App SDK）对 IL Trim 的兼容性较差，
      Release 发布时开启裁剪可能导致运行期 XAML 解析失败（启动即崩溃）。
      如需实验性开启，请在发布命令中显式传入：-p:PublishTrimmed=true
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <Target Name="WindBoard_CopyWinUIResourcesToPublishDirectory" AfterTargets="Publish">
    <!--
      关键：WinUI 3 的 XAML 会被编译为 .xbf（二进制 XAML）并依赖 .pri（资源索引）。
      dotnet publish 只会发布托管/运行时依赖，默认不会包含这些文件，导致运行期 LoadComponent 失败。
    -->
    <ItemGroup>
      <_WindBoardWinUIXbf Include="$(TargetDir)**\*.xbf" />
      <_WindBoardWinUIPri Include="$(TargetDir)*.pri" />
    </ItemGroup>

    <Message Importance="High" Text="复制 WinUI 资源到发布目录：xbf=@(_WindBoardWinUIXbf-&gt;Count())，pri=@(_WindBoardWinUIPri-&gt;Count())，publishDir='$(PublishDir)'" />

    <Copy SourceFiles="@(_WindBoardWinUIXbf)" DestinationFiles="@(_WindBoardWinUIXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(_WindBoardWinUIPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target
    Name="WindBoard_GenerateLocalizationMetadata"
    BeforeTargets="CoreCompile"
    Inputs="@(PRIResource);$(MSBuildProjectDirectory)\Build\GenerateLocalizationMetadata.ps1"
    Outputs="$(WindBoardLocalizationMetadataFile)">
    <MakeDir Directories="$(WindBoardGeneratedLocalizationDir)" />
    <Exec Command="pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\GenerateLocalizationMetadata.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -OutputFile &quot;$(WindBoardLocalizationMetadataFile)&quot;" />
  </Target>

  <Target Name="WindBoard_BuildCrashReporterIntoAppOutput" AfterTargets="Build">
    <PropertyGroup>
      <_WindBoardCrashReporterProject>$(MSBuildProjectDirectory)\..\WindBoard.CrashReporter\WindBoard.CrashReporter.csproj</_WindBoardCrashReporterProject>
      <_WindBoardCrashReporterPlatform>$(Platform)</_WindBoardCrashReporterPlatform>
      <_WindBoardCrashReporterPlatform Condition="'$(_WindBoardCrashReporterPlatform)' == '' or '$(_WindBoardCrashReporterPlatform)' == 'AnyCPU'">x64</_WindBoardCrashReporterPlatform>
      <_WindBoardCrashReporterPlatform Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</_WindBoardCrashReporterPlatform>
      <_WindBoardCrashReporterPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</_WindBoardCrashReporterPlatform>
      <_WindBoardCrashReporterPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</_WindBoardCrashReporterPlatform>
    </PropertyGroup>

    <Message Importance="High" Text="构建 CrashReporter 到主程序输出目录：project='$(_WindBoardCrashReporterProject)'，platform='$(_WindBoardCrashReporterPlatform)'，outDir='$(TargetDir)'" />

    <MSBuild Projects="$(_WindBoardCrashReporterProject)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(_WindBoardCrashReporterPlatform);OutDir=$(TargetDir)" />
  </Target>

  <Target Name="WindBoard_PublishCrashReporter" AfterTargets="Publish">
    <!--
      发布独立 CrashReporter：用于主进程崩溃时仍能提示用户并提供日志/报告入口。

      重要：将 CrashReporter 发布到与主程序相同的 publish 目录（$(PublishDir)），原因：
      - self-contained 变体下，CrashReporter 也必须 self-contained：它依赖 Microsoft.WindowsDesktop.App，
        不能假设 WinUI 主程序目录已提供该共享框架；
      - framework-dependent 变体下，继续按 framework-dependent 发布，避免重复打包运行时。
    -->
    <PropertyGroup>
      <_WindBoardCrashReporterProject>$(MSBuildProjectDirectory)\..\WindBoard.CrashReporter\WindBoard.CrashReporter.csproj</_WindBoardCrashReporterProject>
      <_WindBoardCrashReporterSelfContained>$(SelfContained)</_WindBoardCrashReporterSelfContained>
      <_WindBoardCrashReporterSelfContained Condition="'$(_WindBoardCrashReporterSelfContained)' == ''">false</_WindBoardCrashReporterSelfContained>
    </PropertyGroup>

    <Message Importance="High" Text="发布 CrashReporter：project='$(_WindBoardCrashReporterProject)'，publishDir='$(PublishDir)'，rid='$(RuntimeIdentifier)'，selfContained='$(_WindBoardCrashReporterSelfContained)'" />

    <MSBuild Projects="$(_WindBoardCrashReporterProject)" Targets="Restore;Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(_WindBoardCrashReporterSelfContained);PublishDir=$(PublishDir)" />
  </Target>
</Project>
