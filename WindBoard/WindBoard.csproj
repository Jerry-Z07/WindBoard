<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WindBoard</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- 伪装功能需要生成/处理 .ico：使用 System.Drawing（Windows-only）。 -->
    <UseSystemDrawing>true</UseSystemDrawing>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\Eraser.svg" />
    <Content Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      dotnet publish 默认不会把这些静态资源复制到发布目录，导致便携版/安装包缺少 Assets 后，
      WinUI 在加载 XAML（例如 SvgImageSource / 图标资源）时会触发 XamlParseException（启动即崩溃）。
    -->
    <Content Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.3" />
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.2" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--
      重要：WinUI 3（Windows App SDK）对 IL Trim 的兼容性较差，
      Release 发布时开启裁剪可能导致运行期 XAML 解析失败（启动即崩溃）。
      如需实验性开启，请在发布命令中显式传入：-p:PublishTrimmed=true
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <Target Name="WindBoard_CopyWinUIResourcesToPublishDirectory" AfterTargets="Publish">
    <!--
      关键：WinUI 3 的 XAML 会被编译为 .xbf（二进制 XAML）并依赖 .pri（资源索引）。
      dotnet publish 只会发布托管/运行时依赖，默认不会包含这些文件，导致运行期 LoadComponent 失败。
    -->
    <ItemGroup>
      <_WindBoardWinUIXbf Include="$(TargetDir)**\*.xbf" />
      <_WindBoardWinUIPri Include="$(TargetDir)*.pri" />
    </ItemGroup>

    <Message Importance="High"
             Text="复制 WinUI 资源到发布目录：xbf=@(_WindBoardWinUIXbf->Count())，pri=@(_WindBoardWinUIPri->Count())，publishDir='$(PublishDir)'" />

    <Copy
      SourceFiles="@(_WindBoardWinUIXbf)"
      DestinationFiles="@(_WindBoardWinUIXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="@(_WindBoardWinUIPri)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
