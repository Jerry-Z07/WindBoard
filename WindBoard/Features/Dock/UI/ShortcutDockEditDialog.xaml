<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WindBoard.Features.Dock.UI.ShortcutDockEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:local="using:WindBoard.Features.Dock.UI"
    CloseButtonText="{l10n:Loc Key=Common_Cancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="{l10n:Loc Key=Common_Save}"
    Title="{l10n:Loc Key=Dock_Edit_ShortcutDialog_Title}">

    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="360" Spacing="12">
            <InfoBar
                x:Name="ValidationBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    Opacity="0.75"
                    Text="{l10n:Loc Key=Common_Type}" />
                <ComboBox
                    Grid.Column="1"
                    SelectedValue="{x:Bind Editor.Type, Mode=TwoWay}"
                    SelectedValuePath="Tag">
                    <ComboBoxItem Content="{l10n:Loc Key=Common_File}" Tag="file" />
                    <ComboBoxItem Content="{l10n:Loc Key=Common_Link}" Tag="link" />
                    <ComboBoxItem Content="{l10n:Loc Key=Common_Program}" Tag="program" />
                </ComboBox>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind Editor.PathHeader, Mode=OneWay}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox
                        PlaceholderText="{x:Bind Editor.PathPlaceholder, Mode=OneWay}"
                        Text="{x:Bind Editor.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Click="OnBrowsePathClicked"
                        Content="{l10n:Loc Key=Common_SelectEllipsis}"
                        Visibility="{x:Bind Editor.PathBrowseVisibility, Mode=OneWay}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{l10n:Loc Key=Common_DisplayName}" />
                <TextBox
                    PlaceholderText="{l10n:Loc Key=Settings_Dock_DisplayName_Placeholder}"
                    Text="{x:Bind Editor.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{l10n:Loc Key=Common_Icon}" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <ComboBox
                        SelectedValue="{x:Bind Editor.IconSource, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="{l10n:Loc Key=Common_Default}" Tag="default" />
                        <ComboBoxItem Content="{l10n:Loc Key=Settings_Dock_IconSource_Custom}" Tag="icon" />
                        <ComboBoxItem Content="{l10n:Loc Key=Settings_Dock_IconSource_Font}" Tag="font" />
                    </ComboBox>
                    <TextBox
                        Grid.Column="1"
                        PlaceholderText="{l10n:Loc Key=Settings_Dock_IconPath_Placeholder}"
                        Text="{x:Bind Editor.IconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind Editor.IconPathTextVisibility, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        Click="OnBrowseIconClicked"
                        Content="{l10n:Loc Key=Common_SelectEllipsis}"
                        Visibility="{x:Bind Editor.IconBrowseVisibility, Mode=OneWay}" />
                </Grid>

                <StackPanel Spacing="6" Visibility="{x:Bind Editor.IconFontPanelVisibility, Mode=OneWay}">
                    <TextBox
                        PlaceholderText="{l10n:Loc Key=Settings_Dock_FontIconSearch_Placeholder}"
                        Text="{x:Bind Editor.FontIconSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ListView
                        MaxHeight="160"
                        ItemsSource="{x:Bind Editor.FilteredFontIcons, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{x:Bind Editor.SelectedFontIcon, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="2" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ShortcutDockFontIcon">
                                <StackPanel
                                    Width="96"
                                    Padding="6"
                                    Spacing="4">
                                    <SymbolIcon HorizontalAlignment="Center" Symbol="{x:Bind Symbol}" />
                                    <TextBlock
                                        FontSize="11"
                                        Text="{x:Bind Name}"
                                        TextAlignment="Center"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Opacity="0.75"
                        Text="{x:Bind Editor.FontIconSelectionHint, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <TextBlock
                    Opacity="0.75"
                    Text="{x:Bind Editor.IconHint, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <StackPanel Spacing="6" Visibility="{x:Bind Editor.ArgumentsPanelVisibility, Mode=OneWay}">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{l10n:Loc Key=Common_Arguments}" />
                <TextBox
                    PlaceholderText="{l10n:Loc Key=Settings_Dock_Arguments_Placeholder}"
                    Text="{x:Bind Editor.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
