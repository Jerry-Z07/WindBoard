<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindBoard.Features.Shortcuts.UI.ShortcutsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24">
                <TextBlock Text="{l10n:Loc Key=Settings_Shortcuts_Title}" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="{l10n:Loc Key=Settings_Shortcuts_Description}"
                    Opacity="0.75"
                    TextWrapping="WrapWholeWords" />

                <StackPanel Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Shortcuts_Keyboard_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <StackPanel Spacing="12">
                        <controls:SettingsCard Header="{l10n:Loc Key=Settings_Shortcuts_ConflictReminder_Header}">
                            <controls:SettingsCard.Content>
                                <ToggleSwitch
                                    x:Name="ConflictReminderToggleSwitch"
                                    Header="{x:Null}"
                                    OffContent="{l10n:Loc Key=Settings_Shortcuts_ConflictReminder_Off}"
                                    OnContent="{l10n:Loc Key=Settings_Shortcuts_ConflictReminder_On}"
                                    Toggled="OnConflictReminderToggleSwitchToggled" />
                            </controls:SettingsCard.Content>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Name="UndoShortcutCard"
                            IsClickEnabled="True"
                            Click="OnUndoShortcutClicked"
                            Header="{l10n:Loc Key=Settings_Shortcuts_Undo_Title}">
                            <controls:SettingsCard.HeaderIcon>
                                <!-- 撤销：Undo 图标（MDL2） -->
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Glyph="&#xE10E;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Content>
                                <TextBlock
                                    x:Name="UndoShortcutTextBlock"
                                    Opacity="0.75"
                                    VerticalAlignment="Center" />
                            </controls:SettingsCard.Content>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Name="RedoShortcutCard"
                            IsClickEnabled="True"
                            Click="OnRedoShortcutClicked"
                            Header="{l10n:Loc Key=Settings_Shortcuts_Redo_Title}">
                            <controls:SettingsCard.HeaderIcon>
                                <!-- 重做：Redo 图标（MDL2） -->
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Glyph="&#xE10D;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Content>
                                <TextBlock
                                    x:Name="RedoShortcutTextBlock"
                                    Opacity="0.75"
                                    VerticalAlignment="Center" />
                            </controls:SettingsCard.Content>
                        </controls:SettingsCard>
                    </StackPanel>

                    <controls:SettingsCard
                        IsClickEnabled="True"
                        Click="OnResetToDefaultClicked"
                        Header="{l10n:Loc Key=Common_ResetToDefault}">
                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="Refresh" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="{l10n:Loc Key=Settings_Shortcuts_Mouse_SectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{l10n:Loc Key=Settings_Shortcuts_Mouse_SectionDescription}"
                        Opacity="0.75"
                        TextWrapping="WrapWholeWords" />

                    <StackPanel Spacing="12">
                        <controls:SettingsCard Header="{l10n:Loc Key=Settings_Shortcuts_Mouse_PanViewport_Title}">
                            <controls:SettingsCard.HeaderIcon>
                                <SymbolIcon Symbol="TouchPointer" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Content>
                                <TextBlock
                                    Text="{l10n:Loc Key=Settings_Shortcuts_Mouse_PanViewport_Gesture}"
                                    Opacity="0.75"
                                    VerticalAlignment="Center" />
                            </controls:SettingsCard.Content>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{l10n:Loc Key=Settings_Shortcuts_Mouse_ZoomViewport_Title}">
                            <controls:SettingsCard.HeaderIcon>
                                <SymbolIcon Symbol="TouchPointer" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Content>
                                <TextBlock
                                    Text="{l10n:Loc Key=Settings_Shortcuts_Mouse_ZoomViewport_Gesture}"
                                    Opacity="0.75"
                                    VerticalAlignment="Center" />
                            </controls:SettingsCard.Content>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{l10n:Loc Key=Settings_Shortcuts_Mouse_ZoomSelection_Title}">
                            <controls:SettingsCard.HeaderIcon>
                                <SymbolIcon Symbol="TouchPointer" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Content>
                                <TextBlock
                                    Text="{l10n:Loc Key=Settings_Shortcuts_Mouse_ZoomSelection_Gesture}"
                                    Opacity="0.75"
                                    VerticalAlignment="Center" />
                            </controls:SettingsCard.Content>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{l10n:Loc Key=Settings_Shortcuts_Mouse_RotateSelection_Title}">
                            <controls:SettingsCard.HeaderIcon>
                                <SymbolIcon Symbol="TouchPointer" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Content>
                                <TextBlock
                                    Text="{l10n:Loc Key=Settings_Shortcuts_Mouse_RotateSelection_Gesture}"
                                    Opacity="0.75"
                                    VerticalAlignment="Center" />
                            </controls:SettingsCard.Content>
                        </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="EditShortcutDialog"
            PrimaryButtonText="{l10n:Loc Key=Common_OK}"
            CloseButtonText="{l10n:Loc Key=Common_Cancel}"
            Opened="OnEditShortcutDialogOpened"
            PrimaryButtonClick="OnEditShortcutDialogPrimaryButtonClick">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="{l10n:Loc Key=Settings_Shortcuts_EditDialog_Hint}"
                    Opacity="0.75"
                    TextWrapping="WrapWholeWords" />

                <!--
                    只读输入框：用于捕获 KeyDown 并展示当前“预览快捷键”。
                    说明：不允许手工输入，避免输入格式引发歧义；统一由解析器输出规范字符串。
                -->
                <TextBox
                    x:Name="GestureCaptureTextBox"
                    IsReadOnly="True"
                    PlaceholderText="{l10n:Loc Key=Settings_Shortcuts_NotSet}"
                    KeyDown="OnGestureCaptureTextBoxKeyDown" />

                <InfoBar
                    x:Name="EditShortcutErrorBar"
                    IsOpen="False"
                    Severity="Error"
                    IsIconVisible="True" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
