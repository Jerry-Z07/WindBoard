<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WindBoard.Features.Import.UI.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{l10n:Loc Key=ImportDialog_Title}"
    PrimaryButtonText="{l10n:Loc Key=Common_Import}"
    CloseButtonText="{l10n:Loc Key=Common_Cancel}"
    DefaultButton="Primary"
    CornerRadius="12">

    <ContentDialog.Resources>
        <Style
            x:Key="ImportDialogBaseAccentButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource AccentButtonStyle}" />

        <Style
            x:Key="AccentButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource ImportDialogBaseAccentButtonStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="20,8" />
        </Style>

        <Style
            x:Key="ImportDialogPrimaryButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="20,8" />
        </Style>

        <Style
            x:Key="ImportDialogCloseButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="20,8" />
        </Style>

        <DataTemplate x:Key="StorageFileItemTemplate">
            <Grid Padding="8,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <SymbolIcon Symbol="OpenFile" Opacity="0.75" />

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Path}" Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style
            x:Key="ImportActionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <!--
            统一“卡片容器”观感：与设置页中的卡片样式保持一致，避免导入弹窗显得突兀。
        -->
        <Style x:Key="ImportCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </ContentDialog.Resources>

    <Grid MinWidth="720" MaxWidth="920" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="DialogInfoBar"
            IsOpen="False"
            Severity="Warning"
            IsIconVisible="True" />

        <!--
            导入入口使用 NavigationView：改为“顶部导航 + 下方内容”布局，释放横向空间，让文件路径等信息显示更完整。
            注意：这里不做页面导航（Frame.Navigate），改为切换不同 Panel 的 Visibility，避免引入额外 Page/UserControl。
        -->
        <NavigationView
            x:Name="ImportNavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            AlwaysShowHeader="False"
            PaneDisplayMode="Top"
            SelectionChanged="OnImportNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{l10n:Loc Key=ImportDialog_Tab_Image}" Tag="image">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l10n:Loc Key=ImportDialog_Tab_Media}" Tag="media">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Video" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l10n:Loc Key=ImportDialog_Tab_Text}" Tag="text">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Edit" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l10n:Loc Key=ImportDialog_Tab_Link}" Tag="link">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Link" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l10n:Loc Key=ImportDialog_Tab_Wbix}" Tag="wbix">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="OpenFile" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="12,12,12,0">
                <Grid
                    x:Name="ImageImportPanel"
                    RowSpacing="12"
                    Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnPickImagesClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="{l10n:Loc Key=ImportDialog_PickImages}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnClearImagesClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="{l10n:Loc Key=Common_Clear}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Style="{StaticResource ImportCardBorderStyle}">
                        <ListView
                            ItemsSource="{x:Bind ImageFiles}"
                            ItemTemplate="{StaticResource StorageFileItemTemplate}"
                            MinHeight="160"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>

                <Grid
                    x:Name="MediaImportPanel"
                    RowSpacing="12"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnPickMediaClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="{l10n:Loc Key=ImportDialog_PickMedia}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnClearMediaClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="{l10n:Loc Key=Common_Clear}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Style="{StaticResource ImportCardBorderStyle}">
                        <ListView
                            ItemsSource="{x:Bind MediaFiles}"
                            ItemTemplate="{StaticResource StorageFileItemTemplate}"
                            MinHeight="160"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>

                <Grid
                    x:Name="TextImportPanel"
                    RowSpacing="12"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="TextContentTextBox"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        MinHeight="120"
                        PlaceholderText="{l10n:Loc Key=Import_Text_Placeholder}"
                        TextChanged="OnTextContentChanged" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnPickTextFilesClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="{l10n:Loc Key=ImportDialog_PickTextFiles}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnPasteTextClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Paste" />
                                <TextBlock Text="{l10n:Loc Key=ImportDialog_PasteFromClipboard}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnClearTextClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="{l10n:Loc Key=Common_Clear}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Row="2"
                        Style="{StaticResource ImportCardBorderStyle}">
                        <ListView
                            ItemsSource="{x:Bind TextFiles}"
                            ItemTemplate="{StaticResource StorageFileItemTemplate}"
                            MinHeight="160"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>

                <Grid
                    x:Name="LinkImportPanel"
                    RowSpacing="12"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="LinkLinesTextBox"
                        Grid.Row="0"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        MinHeight="160"
                        PlaceholderText="{l10n:Loc Key=ImportDialog_LinkLines_Placeholder}"
                        TextChanged="OnLinkLinesChanged" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnPasteLinksClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Paste" />
                                <TextBlock Text="{l10n:Loc Key=ImportDialog_PasteFromClipboard}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnClearLinksClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="{l10n:Loc Key=Common_Clear}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="WbixImportPanel"
                    RowSpacing="12"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnPickWbixClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="{l10n:Loc Key=ImportDialog_PickWbix}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ClearWbixButton"
                            Style="{StaticResource ImportActionButtonStyle}"
                            Click="OnClearWbixClicked"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="{l10n:Loc Key=Common_Clear}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border
                        x:Name="WbixPreviewBorder"
                        Grid.Row="1"
                        Style="{StaticResource ImportCardBorderStyle}"
                        Padding="12"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Border
                                    x:Name="WbixCoverFallbackBorder"
                                    Width="240"
                                    Height="180"
                                    CornerRadius="12"
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{l10n:Loc Key=Import_Wbix_NoCover}" />
                                </Border>
                                <Border
                                    x:Name="WbixCoverImageBorder"
                                    Width="240"
                                    Height="180"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                    <Image
                                        x:Name="WbixCoverImage"
                                        Stretch="UniformToFill" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="WbixInfoTextBlock" TextWrapping="WrapWholeWords" />

                                <TextBlock Text="{l10n:Loc Key=Import_Wbix_InsertMethod_Label}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <RadioButton x:Name="WbixAppendRadioButton" Content="{l10n:Loc Key=Import_Wbix_Mode_Append}" IsChecked="True" />
                                <RadioButton x:Name="WbixReplaceCurrentPageRadioButton" Content="{l10n:Loc Key=Import_Wbix_Mode_ReplaceCurrentPage}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</ContentDialog>
