<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WindBoard.Features.Import.UI.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{l10n:Loc Key=ImportDialog_Title}"
    PrimaryButtonText="{l10n:Loc Key=Common_Import}"
    CloseButtonText="{l10n:Loc Key=Common_Cancel}"
    DefaultButton="Primary"
    CornerRadius="12">

    <ContentDialog.Resources>
        <!--
            WinUI 的 ContentDialog 模板使用 ThemeResource（ContentDialogMaxWidth 等）来限制窗口大小，
            仅设置控件自身的 Min/MaxWidth 不生效，因此在弹窗资源域内覆写这些 ThemeResource。
        -->
        <x:Double x:Key="ContentDialogMinWidth">1040</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double>

        <Style
            x:Key="ImportDialogBaseAccentButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource AccentButtonStyle}" />

        <Style
            x:Key="AccentButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource ImportDialogBaseAccentButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="20,8" />
        </Style>

        <Style
            x:Key="ImportDialogPrimaryButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="20,8" />
        </Style>

        <Style
            x:Key="ImportDialogCloseButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="20,8" />
        </Style>

        <Style
            x:Key="ImportActionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style
            x:Key="ImportIconActionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!--
            统一"卡片容器"观感：与设置页中的卡片样式保持一致，避免导入弹窗显得突兀。
        -->
        <Style x:Key="ImportCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <!-- 文本/链接导入区域卡片样式：无外边框，仅背景区分 -->
        <Style x:Key="ImportInputCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- 队列项卡片行样式 -->
        <Style x:Key="QueueItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <!-- 工作区预览卡片样式 -->
        <Style x:Key="WorkspacePreviewBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- 队列项删除按钮样式 -->
        <Style x:Key="QueueItemRemoveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <Grid x:Name="DialogRootGrid" MinWidth="1040" MaxWidth="1320" MinHeight="620" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="DialogInfoBar"
            IsOpen="False"
            Severity="Warning"
            IsIconVisible="True" />

        <!-- 顶部 TabView：文件导入 / 文本链接导入 -->
        <TabView
            x:Name="ImportTabView"
            Grid.Row="1"
            IsAddTabButtonVisible="False"
            CanDragTabs="False"
            CanReorderTabs="False"
            TabWidthMode="Equal"
            SelectedIndex="0"
            SelectionChanged="OnTabSelectionChanged">
            <TabViewItem
                Header="{l10n:Loc Key=ImportDialog_Tab_File}"
                IsClosable="False">
                <TabViewItem.IconSource>
                    <SymbolIconSource Symbol="OpenFile" />
                </TabViewItem.IconSource>
            </TabViewItem>
            <TabViewItem
                Header="{l10n:Loc Key=ImportDialog_Tab_TextLink}"
                IsClosable="False">
                <TabViewItem.IconSource>
                    <SymbolIconSource Symbol="Edit" />
                </TabViewItem.IconSource>
            </TabViewItem>
        </TabView>

        <!--
            主内容区：左右分栏
            - 左侧：导入入口面板（文件拖拽区 / 文本链接输入）
            - 右侧：待导入内容卡片列表
        -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：文件导入面板 -->
            <ScrollViewer
                x:Name="FileImportPanel"
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,8,0,0">
                    <Border
                        x:Name="FileDropZoneBorder"
                        Style="{StaticResource ImportCardBorderStyle}"
                        Padding="24"
                        MinHeight="160"
                        AllowDrop="True"
                        DragOver="OnFileDropZoneDragOver"
                        Drop="OnFileDropZoneDrop"
                        Tapped="OnPickFilesClicked">
                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <SymbolIcon Symbol="OpenFile" Opacity="0.75" />
                            <TextBlock Text="{l10n:Loc Key=ImportDialog_FileDrop_Title}" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{l10n:Loc Key=ImportDialog_FileDrop_Subtitle}"
                                Opacity="0.65"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 左侧：文本/链接导入面板 -->
            <ScrollViewer
                x:Name="TextLinkImportPanel"
                Grid.Column="0"
                Visibility="Collapsed"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Padding="0,8,0,0">
                    <Border Style="{StaticResource ImportInputCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{l10n:Loc Key=ImportDialog_Tab_Text}" FontWeight="SemiBold" />

                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBox
                                        x:Name="TextDraftTextBox"
                                        AcceptsReturn="True"
                                        TextWrapping="NoWrap"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        MinHeight="40"
                                        Padding="10,8,82,8"
                                        CornerRadius="8"
                                        TextChanged="OnTextDraftTextChanged"
                                        PlaceholderText="{l10n:Loc Key=Import_Text_Placeholder}" />

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,4,0"
                                        IsHitTestVisible="True">
                                        <Button
                                            Style="{StaticResource ImportIconActionButtonStyle}"
                                            Click="OnPasteTextClicked"
                                            ToolTipService.ToolTip="{l10n:Loc Key=ImportDialog_PasteFromClipboard}">
                                            <SymbolIcon Symbol="Paste" />
                                        </Button>

                                        <Button
                                            Style="{StaticResource ImportIconActionButtonStyle}"
                                            Click="OnClearTextDraftClicked"
                                            ToolTipService.ToolTip="{l10n:Loc Key=Common_Clear}">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Button
                                    x:Name="AddTextToQueueButton"
                                    Grid.Row="1"
                                    Style="{StaticResource ImportActionButtonStyle}"
                                    Click="OnAddTextToQueueClicked"
                                    IsEnabled="False"
                                    HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add" />
                                        <TextBlock Text="{l10n:Loc Key=ImportDialog_AddTextToQueue}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ImportInputCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{l10n:Loc Key=ImportDialog_Tab_Link}" FontWeight="SemiBold" />

                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBox
                                        x:Name="LinkDraftTextBox"
                                        AcceptsReturn="True"
                                        TextWrapping="NoWrap"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        MinHeight="40"
                                        Padding="10,8,82,8"
                                        CornerRadius="8"
                                        TextChanged="OnLinkDraftTextChanged"
                                        PlaceholderText="{l10n:Loc Key=ImportDialog_LinkLines_Placeholder}" />

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,4,0"
                                        IsHitTestVisible="True">
                                        <Button
                                            Style="{StaticResource ImportIconActionButtonStyle}"
                                            Click="OnPasteLinksClicked"
                                            ToolTipService.ToolTip="{l10n:Loc Key=ImportDialog_PasteFromClipboard}">
                                            <SymbolIcon Symbol="Paste" />
                                        </Button>

                                        <Button
                                            Style="{StaticResource ImportIconActionButtonStyle}"
                                            Click="OnClearLinksDraftClicked"
                                            ToolTipService.ToolTip="{l10n:Loc Key=Common_Clear}">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Button
                                    x:Name="AddLinksToQueueButton"
                                    Grid.Row="1"
                                    Style="{StaticResource ImportActionButtonStyle}"
                                    Click="OnAddLinksToQueueClicked"
                                    IsEnabled="False"
                                    HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add" />
                                        <TextBlock Text="{l10n:Loc Key=ImportDialog_AddLinksToQueue}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧：待导入内容列表 -->
            <Border
                Grid.Column="1"
                Style="{StaticResource ImportCardBorderStyle}"
                Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 列表标题 + 清空按钮 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{l10n:Loc Key=ImportDialog_Queue_Title}" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <Button
                            Grid.Column="1"
                            Style="{StaticResource ImportActionButtonStyle}"
                            Click="OnClearQueueClicked"
                            MinHeight="32"
                            Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="{l10n:Loc Key=ImportDialog_Queue_ClearAll}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 队列内容区域 -->
                    <Grid Grid.Row="1">
                        <ScrollViewer
                            x:Name="QueueScrollViewer"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel x:Name="QueueItemsPanel" Spacing="6" />
                        </ScrollViewer>

                        <!-- WBIX/WBI 工作区预览：在队列项列表上方展示 -->
                        <ScrollViewer
                            x:Name="WorkspacePreviewScrollViewer"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <Border Style="{StaticResource WorkspacePreviewBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid>
                                            <Border
                                                x:Name="WbixCoverFallbackBorder"
                                                Width="200"
                                                Height="150"
                                                CornerRadius="8"
                                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{l10n:Loc Key=Import_Wbix_NoCover}" />
                                            </Border>
                                            <Border
                                                x:Name="WbixCoverImageBorder"
                                                Width="200"
                                                Height="150"
                                                CornerRadius="8"
                                                Visibility="Collapsed">
                                                <Image
                                                    x:Name="WbixCoverImage"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock x:Name="WbixInfoTextBlock" TextWrapping="WrapWholeWords" />

                                            <TextBlock Text="{l10n:Loc Key=Import_Wbix_InsertMethod_Label}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            <RadioButton x:Name="WbixAppendRadioButton" Content="{l10n:Loc Key=Import_Wbix_Mode_Append}" IsChecked="True" />
                                            <RadioButton x:Name="WbixReplaceCurrentPageRadioButton" Content="{l10n:Loc Key=Import_Wbix_Mode_ReplaceCurrentPage}" />

                                            <Button
                                                Style="{StaticResource ImportActionButtonStyle}"
                                                Click="OnClearWbixClicked"
                                                Margin="0,4,0,0"
                                                MinHeight="28"
                                                Padding="12,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <SymbolIcon Symbol="Delete" />
                                                    <TextBlock Text="{l10n:Loc Key=ImportDialog_RemoveFromQueue}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 空状态提示 -->
                        <TextBlock
                            x:Name="QueueEmptyHintTextBlock"
                            Text="{l10n:Loc Key=ImportDialog_Queue_EmptyHint}"
                            Visibility="Visible"
                            Opacity="0.65"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="18,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
