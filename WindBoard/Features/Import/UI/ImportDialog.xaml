<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WindBoard.Features.Import.UI.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{l10n:Loc Key=ImportDialog_Title}"
    PrimaryButtonText="{l10n:Loc Key=Common_Import}"
    CloseButtonText="{l10n:Loc Key=Common_Cancel}"
    DefaultButton="Primary"
    CornerRadius="12">

    <ContentDialog.Resources>
        <!--
            WinUI 的 ContentDialog 模板使用 ThemeResource（ContentDialogMaxWidth 等）来限制窗口大小，
            仅设置控件自身的 Min/MaxWidth 不生效，因此在弹窗资源域内覆写这些 ThemeResource。
        -->
        <x:Double x:Key="ContentDialogMinWidth">1040</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double>

        <Style
            x:Key="ImportDialogBaseAccentButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource AccentButtonStyle}" />

        <Style
            x:Key="AccentButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource ImportDialogBaseAccentButtonStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="20,8" />
        </Style>

        <Style
            x:Key="ImportDialogPrimaryButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="20,8" />
        </Style>

        <Style
            x:Key="ImportDialogCloseButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="20,8" />
        </Style>

        <DataTemplate x:Key="StorageFileItemTemplate">
            <Grid Padding="8,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <SymbolIcon Symbol="OpenFile" Opacity="0.75" />

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Path}" Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style
            x:Key="ImportActionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <!--
            统一“卡片容器”观感：与设置页中的卡片样式保持一致，避免导入弹窗显得突兀。
        -->
        <Style x:Key="ImportCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <DataTemplate x:Key="ImportQueueNodeTemplate">
            <Grid Padding="6,4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 说明：TreeView 使用 RootNodes(TreeViewNode) 作为数据源，ItemTemplate 的 DataContext 是 TreeViewNode，本模板需从 Content 取展示信息。 -->
                <SymbolIcon Symbol="{Binding Content.Icon}" Opacity="0.75" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Content.Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{Binding Content.Subtitle}"
                        Visibility="{Binding Content.SubtitleVisibility}"
                        Opacity="0.65"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Visibility="{Binding Content.RemoveButtonVisibility}"
                    Click="OnQueueRemoveClicked"
                    Tag="{Binding Content.ItemId}"
                    Style="{StaticResource DefaultButtonStyle}"
                    MinHeight="32"
                    Padding="8,6"
                    CornerRadius="8"
                    ToolTipService.ToolTip="{l10n:Loc Key=ImportDialog_RemoveFromQueue_Tooltip}">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid MinWidth="1040" MaxWidth="1320" MinHeight="620" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="DialogInfoBar"
            IsOpen="False"
            Severity="Warning"
            IsIconVisible="True" />

        <!--
            整体布局：左右分栏
            - 左侧：导入入口（文件 / 文本/链接），图标左侧排列；
            - 右侧：导入队列 TreeView，用于统一展示/删除待导入内容。
        -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <NavigationView
                x:Name="ImportNavView"
                Grid.Column="0"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                IsPaneToggleButtonVisible="False"
                IsPaneOpen="True"
                AlwaysShowHeader="False"
                OpenPaneLength="190"
                PaneDisplayMode="Left"
                SelectionChanged="OnImportNavigationSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="{l10n:Loc Key=ImportDialog_Tab_File}" Tag="file">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="OpenFile" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="{l10n:Loc Key=ImportDialog_Tab_TextLink}" Tag="textLink">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Edit" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid Padding="12,12,12,0">
                    <Grid
                        x:Name="FileImportPanel"
                        Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <Border
                                    x:Name="FileDropZoneBorder"
                                    Style="{StaticResource ImportCardBorderStyle}"
                                    Padding="24"
                                    MinHeight="160"
                                    AllowDrop="True"
                                    DragOver="OnFileDropZoneDragOver"
                                    Drop="OnFileDropZoneDrop"
                                    Tapped="OnPickFilesClicked">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="OpenFile" Opacity="0.75" />
                                        <TextBlock Text="{l10n:Loc Key=ImportDialog_FileDrop_Title}" FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="{l10n:Loc Key=ImportDialog_FileDrop_Subtitle}"
                                            Opacity="0.65"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>

                                <Button
                                    x:Name="ClearWbixButton"
                                    Style="{StaticResource ImportActionButtonStyle}"
                                    Click="OnClearWbixClicked"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Delete" />
                                        <TextBlock Text="{l10n:Loc Key=ImportDialog_RemoveFromQueue}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    x:Name="WbixPreviewBorder"
                                    Style="{StaticResource ImportCardBorderStyle}"
                                    Padding="12"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid>
                                            <Border
                                                x:Name="WbixCoverFallbackBorder"
                                                Width="240"
                                                Height="180"
                                                CornerRadius="12"
                                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{l10n:Loc Key=Import_Wbix_NoCover}" />
                                            </Border>
                                            <Border
                                                x:Name="WbixCoverImageBorder"
                                                Width="240"
                                                Height="180"
                                                CornerRadius="12"
                                                Visibility="Collapsed">
                                                <Image
                                                    x:Name="WbixCoverImage"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock x:Name="WbixInfoTextBlock" TextWrapping="WrapWholeWords" />

                                            <TextBlock Text="{l10n:Loc Key=Import_Wbix_InsertMethod_Label}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            <RadioButton x:Name="WbixAppendRadioButton" Content="{l10n:Loc Key=Import_Wbix_Mode_Append}" IsChecked="True" />
                                            <RadioButton x:Name="WbixReplaceCurrentPageRadioButton" Content="{l10n:Loc Key=Import_Wbix_Mode_ReplaceCurrentPage}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid
                        x:Name="TextLinkImportPanel"
                        Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <Border Style="{StaticResource ImportCardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{l10n:Loc Key=ImportDialog_Tab_Text}" FontWeight="SemiBold" />

                                        <TextBox
                                            x:Name="TextDraftTextBox"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            MinHeight="120"
                                            PlaceholderText="{l10n:Loc Key=Import_Text_Placeholder}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnAddTextToQueueClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <SymbolIcon Symbol="Add" />
                                                    <TextBlock Text="{l10n:Loc Key=ImportDialog_AddTextToQueue}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnPasteTextClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <SymbolIcon Symbol="Paste" />
                                                    <TextBlock Text="{l10n:Loc Key=ImportDialog_PasteFromClipboard}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnClearTextDraftClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <SymbolIcon Symbol="Delete" />
                                                    <TextBlock Text="{l10n:Loc Key=Common_Clear}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ImportCardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{l10n:Loc Key=ImportDialog_Tab_Link}" FontWeight="SemiBold" />

                                        <TextBox
                                            x:Name="LinkDraftTextBox"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            MinHeight="160"
                                            PlaceholderText="{l10n:Loc Key=ImportDialog_LinkLines_Placeholder}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnAddLinksToQueueClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <SymbolIcon Symbol="Add" />
                                                    <TextBlock Text="{l10n:Loc Key=ImportDialog_AddLinksToQueue}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnPasteLinksClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <SymbolIcon Symbol="Paste" />
                                                    <TextBlock Text="{l10n:Loc Key=ImportDialog_PasteFromClipboard}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ImportActionButtonStyle}" Click="OnClearLinksDraftClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <SymbolIcon Symbol="Delete" />
                                                    <TextBlock Text="{l10n:Loc Key=Common_Clear}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView>

            <Border
                Grid.Column="1"
                Style="{StaticResource ImportCardBorderStyle}"
                Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{l10n:Loc Key=ImportDialog_Queue_Title}" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <Button
                            Grid.Column="1"
                            Style="{StaticResource ImportActionButtonStyle}"
                            Click="OnClearQueueClicked"
                            MinHeight="32"
                            Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="{l10n:Loc Key=ImportDialog_Queue_ClearAll}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <TreeView
                            x:Name="ImportQueueTreeView"
                            ItemTemplate="{StaticResource ImportQueueNodeTemplate}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />

                        <TextBlock
                            x:Name="QueueEmptyHintTextBlock"
                            Text="{l10n:Loc Key=ImportDialog_Queue_EmptyHint}"
                            Visibility="Visible"
                            Opacity="0.65"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="18,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
