<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindBoard.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WindBoard">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <!-- 底部 Dock -->

                <Style
                    x:Key="DockButtonStyle"
                    TargetType="Button"
                    BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>

                <Style
                    x:Key="DockToggleButtonStyle"
                    TargetType="ToggleButton"
                    BasedOn="{StaticResource DefaultToggleButtonStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <controls:BoardCanvasControl x:Name="BoardCanvas" />

        <!-- 底部 Dock：左侧“更多/最小化/导入”，中部“工具/撤销重做”，右侧“+”入口 -->
        <!-- 使用三块浮层分别对齐 Left/Center/Right，保证中部 Dock 始终以窗口居中对齐。 -->
        <!-- 底部 Dock 固定为浅色主题：不随系统深色/浅色切换 -->
        <Grid VerticalAlignment="Bottom" Margin="14,0,14,14" RequestedTheme="Light">
            <Grid.Resources>
                <ResourceDictionary>
                    <!-- Dock 内按钮/切换按钮的交互态配色：选中态使用灰色高亮（截图风格） -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#00000000" />

                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#1976D2" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#1976D2" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1976D2" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#1976D2" />
                </ResourceDictionary>
            </Grid.Resources>

            <!-- 左侧 Dock -->
            <Grid
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <!-- 外层底板：仅背景 0.85 透明度，避免影响内部图标/文字不透明度 -->
                <Border
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="14"
                    Opacity="0.85" />
                <StackPanel x:Name="LeftDockPanel" Orientation="Horizontal" Spacing="4" Margin="5">
                    <Button
                        x:Name="MoreButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="设置" Click="OnSettingsClicked">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Setting" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="导出" Click="OnExportClicked">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="OpenFile" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="退出" Click="OnExitClicked">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Cancel" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="More" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="更多" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="MinimizeButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="BackToWindow" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="最小化" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ImportButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="Download" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="导入" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 中部 Dock -->
            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
                <Border
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="14"
                    Opacity="0.85" />
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="5">
                    <StackPanel x:Name="ToolsDockPanel" Orientation="Horizontal" Spacing="4">
                    <ToggleButton
                        x:Name="SelectToolToggleButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        Style="{StaticResource DockToggleButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="TouchPointer" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="选择" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="PenToolToggleButton"
                        IsChecked="True"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        Style="{StaticResource DockToggleButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="Edit" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="书写" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="EraserToggleButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        Style="{StaticResource DockToggleButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <!-- 擦除模式二次点击：弹出“滑动清屏”（清空画布）入口，避免误触一键清空。 -->
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Top" Opened="OnEraserFlyoutOpened" Closed="OnEraserFlyoutClosed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <!-- 禁用 Flyout 默认边框/阴影/焦点框，避免出现“白色方形外框” -->
                                        <Setter Property="CornerRadius" Value="14" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Shadow" Value="{x:Null}" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                                        <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
                                        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <!-- “滑动清屏”确认条 -->
                                <Grid x:Name="ClearCanvasSlideHost" Width="232" Height="52">
                                    <Border
                                        CornerRadius="14"
                                        Background="#C72E333D"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1" />
                                    <TextBlock
                                        x:Name="ClearCanvasSlideText"
                                        Text="滑动清屏"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                    <!-- 拖动圆形把手：使用指针捕获实现拖动，避免 Thumb 在 Flyout 场景下失效 -->
                                    <Border
                                        x:Name="ClearCanvasSlideThumb"
                                        Width="44"
                                        Height="44"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="6,0,0,0"
                                        Background="#F2F2F2"
                                        CornerRadius="22"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        PointerPressed="OnClearCanvasThumbPointerPressed"
                                        PointerMoved="OnClearCanvasThumbPointerMoved"
                                        PointerReleased="OnClearCanvasThumbPointerReleased"
                                        PointerCanceled="OnClearCanvasThumbPointerCanceled"
                                        PointerCaptureLost="OnClearCanvasThumbPointerCaptureLost">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ClearCanvasSlideThumbTransform" />
                                        </Border.RenderTransform>
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="16"
                                            Foreground="#6B6B6B"
                                            Glyph="&#xE74D;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>

                        <StackPanel Orientation="Vertical">
                            <!-- Segoe MDL2 Assets：E75C = EraseTool（橡皮擦） -->
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="20" Glyph="&#xE75C;" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="擦除" />
                        </StackPanel>
                    </ToggleButton>
                    </StackPanel>

                    <Rectangle
                        x:Name="UndoRedoSeparator"
                        Width="1"
                        Height="30"
                        Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                        VerticalAlignment="Center" />

                    <StackPanel x:Name="UndoRedoDockPanel" Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="UndoButton"
                            MinWidth="60"
                            MinHeight="52"
                            Padding="8,6"
                            Style="{StaticResource DockButtonStyle}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <StackPanel Orientation="Vertical">
                                <SymbolIcon Symbol="Undo" />
                                <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="撤销" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="RedoButton"
                            MinWidth="60"
                            MinHeight="52"
                            Padding="8,6"
                            Style="{StaticResource DockButtonStyle}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <StackPanel Orientation="Vertical">
                                <SymbolIcon Symbol="Redo" />
                                <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="重做" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 右侧 Dock：页面切换与页面管理入口 -->
            <Grid
                x:Name="PagesDockBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <!-- 页面管理弹出层：以整个右侧 Dock 作为锚点，保证弹出区域正对 Dock 上方 -->
                <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="PagesFlyout" Placement="TopEdgeAlignedRight">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <!-- 禁用 Flyout 默认边框/阴影/焦点框 -->
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Shadow" Value="{x:Null}" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                                <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
                                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>

                        <Border
                            Width="280"
                            MaxHeight="520"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="14"
                            Padding="12">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <TextBlock
                                    Text="页面管理"
                                    FontSize="16"
                                    FontWeight="SemiBold" />

                                <ListView
                                    x:Name="PagesListView"
                                    Grid.Row="1"
                                    SelectionMode="Single"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnPagesListItemClick"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemContainerStyle>
                                        <!-- 去掉 ListViewItem 默认左右 Padding，避免内容被裁剪（尤其是右侧删除按钮） -->
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="240"
                                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="8"
                                                Margin="0,0,0,8">
                                                <Grid RowDefinitions="24,*" RowSpacing="6">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding Number}"
                                                            FontSize="14"
                                                            FontWeight="SemiBold" />

                                                        <Button
                                                            Grid.Column="2"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            CornerRadius="7"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Tag="{Binding}"
                                                            Click="OnDeletePageClicked">
                                                            <FontIcon
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="12"
                                                                Glyph="&#xE74D;" />
                                                        </Button>
                                                    </Grid>

                                                    <controls:PageThumbnailControl
                                                        Grid.Row="1"
                                                        Height="104"
                                                        Page="{Binding Page}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>

                <Border
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="14"
                    Opacity="0.85" />

                <StackPanel x:Name="PagesDockPanel" Orientation="Horizontal" Spacing="4" Margin="5">
                    <Button
                        x:Name="PagePrevButton"
                        MinWidth="52"
                        MinHeight="52"
                        Padding="0"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <SymbolIcon Symbol="Back" />
                    </Button>

                    <Button
                        x:Name="PageIndicatorButton"
                        MinWidth="84"
                        MinHeight="52"
                        Padding="8,0"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <TextBlock
                            x:Name="PageIndicatorText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="1 / 1" />
                    </Button>

                    <Button
                        x:Name="PageNextButton"
                        MinWidth="52"
                        MinHeight="52"
                        Padding="0"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <SymbolIcon Symbol="Forward" />
                    </Button>

                    <Button
                        x:Name="AddButton"
                        MinWidth="52"
                        MinHeight="52"
                        Padding="0"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <SymbolIcon Symbol="Add" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
