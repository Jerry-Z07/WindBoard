<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindBoard.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WindBoard">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <controls:BoardCanvasControl x:Name="BoardCanvas" />

        <!-- 底部 Dock：左侧“更多/最小化/导入”，中部“工具/撤销重做”，右侧“+”入口 -->
        <!-- 使用三块浮层分别对齐 Left/Center/Right，保证中部 Dock 始终以窗口居中对齐。 -->
        <Grid VerticalAlignment="Bottom" Margin="14,0,14,14">

            <!-- 左侧 Dock -->
            <Border
                HorizontalAlignment="Left"
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="5">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <Button
                        x:Name="MoreButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="设置" Click="OnSettingsClicked">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Setting" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="导出" Click="OnExportClicked">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="OpenFile" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="退出" Click="OnExitClicked">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Cancel" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="More" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="更多" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="MinimizeButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="BackToWindow" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="最小化" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ImportButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="Download" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="导入" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 中部 Dock -->
            <Border
                HorizontalAlignment="Center"
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="5">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <ToggleButton
                        x:Name="SelectToolToggleButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="TouchPointer" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="选择" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="PenToolToggleButton"
                        IsChecked="True"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="Edit" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="书写" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="EraserToggleButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <!-- 擦除模式二次点击：弹出“滑动清屏”（清空画布）入口，避免误触一键清空。 -->
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Top" Opened="OnEraserFlyoutOpened" Closed="OnEraserFlyoutClosed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <!-- 禁用 Flyout 默认边框/阴影/焦点框，避免出现“白色方形外框” -->
                                        <Setter Property="CornerRadius" Value="14" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Shadow" Value="{x:Null}" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                                        <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
                                        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <!-- “滑动清屏”确认条 -->
                                <Grid x:Name="ClearCanvasSlideHost" Width="232" Height="52">
                                    <Border
                                        CornerRadius="14"
                                        Background="#C72E333D"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="1" />
                                    <TextBlock
                                        x:Name="ClearCanvasSlideText"
                                        Text="滑动清屏"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                    <!-- 拖动圆形把手：使用指针捕获实现拖动，避免 Thumb 在 Flyout 场景下失效 -->
                                    <Border
                                        x:Name="ClearCanvasSlideThumb"
                                        Width="44"
                                        Height="44"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="6,0,0,0"
                                        Background="#F2F2F2"
                                        CornerRadius="22"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        PointerPressed="OnClearCanvasThumbPointerPressed"
                                        PointerMoved="OnClearCanvasThumbPointerMoved"
                                        PointerReleased="OnClearCanvasThumbPointerReleased"
                                        PointerCanceled="OnClearCanvasThumbPointerCanceled"
                                        PointerCaptureLost="OnClearCanvasThumbPointerCaptureLost">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ClearCanvasSlideThumbTransform" />
                                        </Border.RenderTransform>
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="16"
                                            Foreground="#6B6B6B"
                                            Glyph="&#xE74D;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>

                        <StackPanel Orientation="Vertical">
                            <!-- Segoe MDL2 Assets：E75C = EraseTool（橡皮擦） -->
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="20" Glyph="&#xE75C;" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="擦除" />
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle
                        Width="1"
                        Height="30"
                        Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                        Margin="5,0"
                        VerticalAlignment="Center" />

                    <Button
                        x:Name="UndoButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="Undo" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="撤销" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="RedoButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="Redo" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="重做" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 右侧 Dock：预留“+”入口（例如：新建页/插入内容等） -->
            <Border
                HorizontalAlignment="Right"
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="5">
                <Button
                    x:Name="AddButton"
                    MinWidth="52"
                    MinHeight="52"
                    Padding="0"
                    CornerRadius="10"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <SymbolIcon Symbol="Add" />
                </Button>
            </Border>
        </Grid>
    </Grid>
</Window>
