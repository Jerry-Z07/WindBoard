<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindBoard.Controls.BoardCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WindBoard.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 选择框缩放手柄：用于导入元素（卡片）缩放。 -->
        <Style x:Key="SelectionHandleThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <SwapChainPanel x:Name="CanvasPanel" />

        <!-- 自绘光标：用于擦除模式（后续可基于擦除大小做缩放）。 -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <!-- 选择框：仅用于视觉提示（交互由输入控制器处理）。 -->
            <Border
                x:Name="SelectionBoundsBorder"
                BorderBrush="{ThemeResource SystemAccentColor}"
                BorderThickness="2"
                CornerRadius="8"
                Background="Transparent"
                Visibility="Collapsed" />

            <Image x:Name="EraserCursorImage" Width="48" Height="72" Stretch="Fill" Visibility="Collapsed">
                <Image.Source>
                    <SvgImageSource UriSource="ms-appx:///Assets/Eraser.svg" />
                </Image.Source>
            </Image>
        </Canvas>

        <!-- 选择框缩放手柄：仅在“选中元素”时显示（交互由 Thumb 拖拽事件处理）。 -->
        <Canvas x:Name="SelectionHandlesCanvas" IsHitTestVisible="True">
            <Thumb x:Name="SelectionHandleTL" Style="{StaticResource SelectionHandleThumbStyle}" Tag="TL" Visibility="Collapsed"
                   DragStarted="OnSelectionHandleDragStarted" DragDelta="OnSelectionHandleDragDelta" DragCompleted="OnSelectionHandleDragCompleted" />
            <Thumb x:Name="SelectionHandleT" Style="{StaticResource SelectionHandleThumbStyle}" Tag="T" Visibility="Collapsed"
                   DragStarted="OnSelectionHandleDragStarted" DragDelta="OnSelectionHandleDragDelta" DragCompleted="OnSelectionHandleDragCompleted" />
            <Thumb x:Name="SelectionHandleTR" Style="{StaticResource SelectionHandleThumbStyle}" Tag="TR" Visibility="Collapsed"
                   DragStarted="OnSelectionHandleDragStarted" DragDelta="OnSelectionHandleDragDelta" DragCompleted="OnSelectionHandleDragCompleted" />
            <Thumb x:Name="SelectionHandleL" Style="{StaticResource SelectionHandleThumbStyle}" Tag="L" Visibility="Collapsed"
                   DragStarted="OnSelectionHandleDragStarted" DragDelta="OnSelectionHandleDragDelta" DragCompleted="OnSelectionHandleDragCompleted" />
            <Thumb x:Name="SelectionHandleR" Style="{StaticResource SelectionHandleThumbStyle}" Tag="R" Visibility="Collapsed"
                   DragStarted="OnSelectionHandleDragStarted" DragDelta="OnSelectionHandleDragDelta" DragCompleted="OnSelectionHandleDragCompleted" />
            <Thumb x:Name="SelectionHandleBL" Style="{StaticResource SelectionHandleThumbStyle}" Tag="BL" Visibility="Collapsed"
                   DragStarted="OnSelectionHandleDragStarted" DragDelta="OnSelectionHandleDragDelta" DragCompleted="OnSelectionHandleDragCompleted" />
            <Thumb x:Name="SelectionHandleB" Style="{StaticResource SelectionHandleThumbStyle}" Tag="B" Visibility="Collapsed"
                   DragStarted="OnSelectionHandleDragStarted" DragDelta="OnSelectionHandleDragDelta" DragCompleted="OnSelectionHandleDragCompleted" />
            <Thumb x:Name="SelectionHandleBR" Style="{StaticResource SelectionHandleThumbStyle}" Tag="BR" Visibility="Collapsed"
                   DragStarted="OnSelectionHandleDragStarted" DragDelta="OnSelectionHandleDragDelta" DragCompleted="OnSelectionHandleDragCompleted" />
        </Canvas>

        <!-- 选中项 Dock：悬浮于选择框下方，仅 Dock 本体可点击（Canvas 背景为空，避免遮挡画布交互）。 -->
        <Canvas x:Name="SelectionDockCanvas">
            <Border
                x:Name="SelectionDockBorder"
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="14"
                Opacity="0.85"
                Visibility="Collapsed"
                RequestedTheme="Light">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="5">
                    <Button
                        x:Name="SelectionBringToFrontButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon x:Name="SelectionBringToFrontIcon" Symbol="Up" />
                            <TextBlock x:Name="SelectionBringToFrontText" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="{l10n:Loc Key=Common_BringToFront}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SelectionDuplicateButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="Copy" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="{l10n:Loc Key=Common_Copy}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SelectionDeleteButton"
                        MinWidth="60"
                        MinHeight="52"
                        Padding="8,6"
                        Style="{StaticResource DockButtonStyle}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <SymbolIcon Symbol="Delete" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" Text="{l10n:Loc Key=Common_Delete}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
