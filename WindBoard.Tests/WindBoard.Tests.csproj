<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x86;x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      CA1707（标识符不应包含下划线）：测试方法命名遵循 .trellis/spec/backend/quality-guidelines.md
      规定的 {Action}_{ExpectedResult} 约定（如 Do_Undo_Redo_KeepsOriginalInsertIndex），
      下划线用于分隔被测行为与预期结果，与该规则的 PascalCase 要求直接冲突，保留项目约定。
      仅对测试项目豁免；主项目代码标识符仍受 CA1707 约束。
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\\WindBoard\\WindBoard.csproj" />
    <ProjectReference Include="..\\WindBoard.CrashReporter\\WindBoard.CrashReporter.csproj" />
    <ProjectReference Include="..\\WindBoard.Launcher\\WindBoard.Launcher.csproj" />
  </ItemGroup>

</Project>
