# .gitignore for WindBoard (.NET) project
# 生成于: 自动生成 - 适配 Visual Studio / .NET / Rider / VS Code

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build artifacts
[Bb]in/
[Oo]bj/
build/
artifacts/
# 保留主项目构建期脚本（用于生成本地化元数据）
!WindBoard/Build/
!WindBoard/Build/GenerateLocalizationMetadata.ps1

# Debug / Release outputs
Debug/
Release/

# NuGet
*.nupkg
packages/
project.lock.json
project.fragment.lock.json
*.snupkg

# Rider
.idea/
*.sln.iml

# Resharper
_ReSharper*/
*._ReSharper.*
*.DotSettings.user

# VS Code
.vscode/

# Test results
TestResults/
*.TestResults

# Coverage and profiling
coverage/
*.coverage
*.coveragexml
*.coverage.xml
coverage*.xml
*.lcov

# Logs
*.log
*.tlog

# Temporary / backup files
*.tmp
*.temp
*.bak
*~
*.swp
_tmp_*/
publish_test/
_verify/

# OS files
Thumbs.db
desktop.ini
.DS_Store
ehthumbs.db

# Dotnet publish / pack
publish/
**/publish/
*.vsix

# Appx/MSIX 打包在源码树生成的中间产物（single-project MSIX 构建副作用）
WindBoard/BundleArtifacts/
# MSIX 产包输出目录（只匹配仓库根的 msix/，必须写成 /msix/：
# 不加前导斜杠会在 Windows 的大小写不敏感匹配下把 WindBoard/Assets/Msix/ 视觉资产一起忽略掉）
/msix/

# NuGet packages and cache
package.lock.json
.nuget/

# Generated files (usually in bin/obj)
*.g.cs
*.g.i.cs
*.generated.cs
*.designer.cs

# Secret / user-specific settings
secrets.json
appsettings.*.Local.json

# Other IDEs / tools
*.sublime-workspace
.idea/
.vscode/

# Ignore JetBrains Rider caches
.idea/
.cache/

# Ignore Intellij project files
*.iml

# Ignore specific temp files that appear in this workspace
*.wpftmp.*



.ace-tool/
# End
