# .gitignore for WindBoard (.NET) project
# 生成于: 自动生成 - 适配 Visual Studio / .NET / Rider / VS Code

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build artifacts
[Bb]in/
[Oo]bj/
build/
artifacts/
# 保留主项目构建期脚本（用于生成本地化元数据）
!WindBoard/Build/
!WindBoard/Build/GenerateLocalizationMetadata.ps1

# Debug / Release outputs
Debug/
Release/

# NuGet
*.nupkg
packages/
project.lock.json
project.fragment.lock.json
*.snupkg

# Rider
.idea/
*.sln.iml

# Resharper
_ReSharper*/
*._ReSharper.*
*.DotSettings.user

# VS Code
.vscode/

# Test results
TestResults/
*.TestResults

# Coverage and profiling
coverage/
*.coverage
*.coveragexml
*.coverage.xml
coverage*.xml
*.lcov

# Logs
*.log
*.tlog

# Temporary / backup files
*.tmp
*.temp
*.bak
*~
*.swp
_tmp_*/
publish_test/
_verify/

# OS files
Thumbs.db
desktop.ini
.DS_Store
ehthumbs.db

# Dotnet publish / pack
publish/
**/publish/
*.vsix

# Appx/MSIX 打包在源码树生成的中间产物
# 说明：main 分支不支持 MSIX 打包、不会产出该目录，但本地切到 develop 做打包后会残留，
# 这里一并忽略，避免这些中间产物被误提交。
WindBoard/BundleArtifacts/

# NuGet packages and cache
package.lock.json
.nuget/

# Generated files (usually in bin/obj)
*.g.cs
*.g.i.cs
*.generated.cs
*.designer.cs

# Secret / user-specific settings
secrets.json
appsettings.*.Local.json

# Other IDEs / tools
*.sublime-workspace
.idea/
.vscode/

# Ignore JetBrains Rider caches
.idea/
.cache/

# Ignore Intellij project files
*.iml

# Ignore specific temp files that appear in this workspace
*.wpftmp.*



.ace-tool/
# End
